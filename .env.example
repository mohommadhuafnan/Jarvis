# =======================================================
# JARVIS PERSONAL AI ASSISTANT - ENVIRONMENT TEMPLATE
# =======================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Google Gemini API Key (SERVER-ONLY)
GOOGLE_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
DEFAULT_MODEL=gemini-2.5-flash

# LiveKit Cloud Realtime Voice Configuration (SERVER-ONLY: NEVER EXPOSE SECRET TO CLIENT)
LIVEKIT_URL=wss://<your-project-subdomain>.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=secret...

# Google OAuth 2.0 (Gmail & Google Calendar)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_PROJECT_ID=YOUR_GOOGLE_PROJECT_ID
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# Assistant Identity & Voice Settings
ASSISTANT_NAME=JARVIS
USER_NAME=RAVIT
WAKE_WORD=Jarvis
LANGUAGE=en

# MongoDB Atlas Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=jarvis

# Optional VALSEA Voice Intelligence
VALSEA_API_KEY=
VALSEA_BASE_URL=https://api.valsea.ai/v1
